# MySQL credentials for the competition database server.
#
# This file IS committed — the competition runs offline and the deployed image needs
# these values baked in (the Kubernetes/pulldeck deploy sets no environment variables).
# Fill in your own username, password and database name below.

DB_HOST=db.sitc.skillsit.eu
DB_PORT=3306

# Your username, e.g. c42
DB_USER=cxx

# Your password
DB_PASS=yyyy

# Your database, e.g. c42_module-a
DB_NAME=cxx_module-z
